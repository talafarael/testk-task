version: '3.8'

services:
  mongodb:
    image: mongo:7.0.3
    container_name: mongodb
    restart: always
    env_file:
      - .env
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${MONGO_DB_USERNAME}
      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_DB_PASSWORD}
    networks:
      - default-network
    volumes:
      - ./mongodb:/data/db
    ports:
      - 27017:27017

networks:
  default-network:
    driver: bridge
